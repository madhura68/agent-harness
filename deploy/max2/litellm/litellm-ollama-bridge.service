# /etc/systemd/system/litellm-ollama-bridge.service: a copy of max2's dsh-ollama-bridge.service for the litellm
# network. Since M45-2d it is an enabled unit under ops-agent (the ops wrapper installs and starts it); the increment-1
# trial only started it by hand during the trial window.
[Unit]
Description=litellm container -> Ollama bridge (172.30.82.1:11434 -> 127.0.0.1:11434)
After=docker.service ollama.service
Requires=docker.service

[Service]
# The gateway address only exists once the litellm network does.
ExecStartPre=/bin/sh -c 'until ip -4 addr show br-litellm 2>/dev/null | grep -q 172.30.82.1; do sleep 2; done'
ExecStart=/usr/bin/socat TCP-LISTEN:11434,bind=172.30.82.1,fork,reuseaddr TCP:127.0.0.1:11434
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
