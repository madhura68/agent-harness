{
  "pin": "285c98ae3fc670f30f82fb5ca3cb8f92a7739dd8",
  "tools": [
    {
      "name": "search_product_docs",
      "description": "Ranked full-text search over title, slug and content_md using Postgres FTS. Returns snippets with ts_headline. Default excludes archived/deprecated docs and disabled folders — set include_archived/include_disabled to opt in. Use websearch syntax for queries: quoted phrases, OR, -negation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "enum": [
              "adr",
              "architecture",
              "grills",
              "patterns",
              "plans",
              "runbooks",
              "specs",
              "manual",
              "api"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "include_archived": {
            "default": false,
            "type": "boolean"
          },
          "include_disabled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "query",
          "product_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_product_doc",
      "description": "Read the content of a ProductDoc. Use `heading` to extract a single section, or `offset`+`max_chars` to paginate large docs (content_md can be up to 100K chars). Default max_chars=12000 stays well under the MCP 10K-token warning.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "enum": [
              "adr",
              "architecture",
              "grills",
              "patterns",
              "plans",
              "runbooks",
              "specs",
              "manual",
              "api"
            ]
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "max_chars": {
            "default": 12000,
            "type": "integer",
            "minimum": 500,
            "maximum": 40000
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "heading": {
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "folder",
          "slug"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_product_docs",
      "description": "List all ProductDocs in a product, optionally filtered by folder and status. Returns metadata only (no content_md) so agents can browse the index cheaply. Use search_product_docs for full-text queries or get_product_doc to read a doc.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "enum": [
              "adr",
              "architecture",
              "grills",
              "patterns",
              "plans",
              "runbooks",
              "specs",
              "manual",
              "api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "deprecated",
              "archived"
            ]
          },
          "include_disabled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "product_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "related_product_docs",
      "description": "For a given doc, returns forward links (docs it mentions) and backward links (docs that reference it). Parses markdown `[text](path.md)` links and resolves them within the product's doc-tree. Broken links are reported separately.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "enum": [
              "adr",
              "architecture",
              "grills",
              "patterns",
              "plans",
              "runbooks",
              "specs",
              "manual",
              "api"
            ]
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "product_id",
          "folder",
          "slug"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
